# ─── Telegram ────────────────────────────────────────────────────────────────
# Get from @BotFather
BOT_TOKEN=your_bot_token_here

# Comma-separated Telegram user IDs with admin rights (e.g. 123456,789012)
ADMIN_IDS=your_telegram_user_id

# The channel or group chat_id that users MUST be a member of to use the bot.
# For public channels: use @channelusername
# For private channels/groups: use the numeric chat_id (e.g. -1001234567890)
ALLOWED_CHAT_ID=@your_channel_or_group

# ─── Google ──────────────────────────────────────────────────────────────────
# Create a Google Service Account, download JSON key, then base64-encode it:
#   Windows PowerShell: [Convert]::ToBase64String([IO.File]::ReadAllBytes("service_account.json"))
#   Linux/Mac:          base64 -w 0 service_account.json
GOOGLE_SERVICE_ACCOUNT_JSON_BASE64=base64_encoded_service_account_json

# Google Sheets spreadsheet ID (from the URL)
# https://docs.google.com/spreadsheets/d/SPREADSHEET_ID/edit
GOOGLE_SPREADSHEET_ID=your_spreadsheet_id

# Google Drive folder ID where screenshots will be uploaded
# https://drive.google.com/drive/folders/FOLDER_ID
GOOGLE_DRIVE_FOLDER_ID=your_drive_folder_id

# ─── Gemini Vision API ───────────────────────────────────────────────────────
# Get from https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key

# ─── Settings ────────────────────────────────────────────────────────────────
# Seconds between submissions per user (anti-spam)
RATE_LIMIT_SECONDS=60

# Webhook secret token (optional but recommended — set the same in BotFather)
WEBHOOK_SECRET=your_random_secret_here
