{
  "version": 2,
  "functions": {
    "api/index.py": {
      "maxDuration": 60,
      "memory": 1024
    }
  },
  "rewrites": [
    { "source": "/api/webhook", "destination": "/api/index" },
    { "source": "/api/setup",   "destination": "/api/index" },
    { "source": "/api/debug",   "destination": "/api/index" },
    { "source": "/(.*)",        "destination": "/api/index" }
  ]
}
